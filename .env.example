# ---- Discord ----
# From https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Your app's "Application ID" (General Information page)
DISCORD_CLIENT_ID=
# Optional: a server ID. If set, slash commands register instantly in that one
# server (good for development). If blank, they register globally and can take
# up to an hour to appear.
DISCORD_GUILD_ID=

# ---- Local speech-to-text sidecar ----
STT_URL=http://127.0.0.1:8756

# ---- Note generation ----
# Which LLM writes the notes: "cloud" (default) or "local".
# A CLI flag beats this:  npm start -- --local   /   npm start -- --cloud
LLM_BACKEND=cloud

# Cloud backend (OpenRouter). Required unless you always run with --local.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Local backend (Ollama). Fully offline; shares the GPU with Whisper.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# ---- Capture tuning ----
# Silence (ms) that ends one "utterance" and sends it off to be transcribed.
SILENCE_MS=800
# Utterances shorter than this (ms) are discarded as noise/breath.
MIN_UTTERANCE_MS=400
# Keep the per-utterance .wav files after the meeting ends (true/false).
KEEP_AUDIO=false
