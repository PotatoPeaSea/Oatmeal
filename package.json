{
  "name": "oatmeal",
  "version": "1.0.0",
  "description": "Oatmeal - a fully local AI note-taking Discord bot. Joins a voice channel, transcribes per-speaker audio with faster-whisper, and DMs markdown meeting notes generated by a local Ollama model.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:local": "node src/index.js --local",
    "register": "node src/register-commands.js",
    "stt": "stt\\.venv\\Scripts\\python.exe stt/server.py"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "libsodium-wrappers": "^0.8.4",
    "prism-media": "^1.3.5"
  }
}
